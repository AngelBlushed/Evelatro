# ====== Discord ======
# Portail dev > ton appli > Bot > Reset Token
DISCORD_TOKEN=colle-ton-token-ici
# Portail dev > ton appli > General Information > Application ID
DISCORD_CLIENT_ID=1542964139637477536
# (facultatif) ID de ton serveur : les commandes apparaissent instantanement.
# Sans ca, les commandes sont globales et mettent ~1h a apparaitre.
# Clic droit sur ton serveur > Copier l'identifiant du serveur (mode dev active)
DISCORD_GUILD_ID=

# ====== Supabase ======
SUPABASE_URL=https://ayptnkxkzvntijgzcatx.supabase.co
# IMPORTANT : la cle "service_role" (Settings > API > service_role).
# Elle NE DOIT JAMAIS etre publique ni dans le jeu. Ici c'est cote serveur, OK.
SUPABASE_KEY=colle-la-cle-service_role-ici

# ====== Options ======
# URL de ton site (bouton "Mettre a jour" du panneau /news du jeu)
SITE_URL=https://ton-site.netlify.app

# (facultatif, remplace par /feed) salon ou poster chaque action
LIVE_CHANNEL_ID=

# Mettre a 1 une seule fois pour donner emilia.png en photo de profil au bot.
SET_AVATAR=0
